rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User data collection (goals, sessions, maangWeeks, health, jobOutreaches, youtubeShorts)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Top-level users collection for Admin permissions directory
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // App Feature Permissions collection for Admin access control
    match /appPermissions/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
